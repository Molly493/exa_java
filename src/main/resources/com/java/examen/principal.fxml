<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane tabClosingPolicy="UNAVAILABLE" prefWidth="700" prefHeight="450"
         xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.java.examen.PrincipalController">

    <!-- TAB 1: LECTURA -->
    <Tab text="Lectura">
        <VBox spacing="10">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Button text="Mostrar registros" onAction="#onLeer"/>
            <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" maxWidth="60"/>
                    <TableColumn fx:id="colUsuario" text="Usuario"/>
                    <TableColumn fx:id="colNombres" text="Nombres"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos"/>
                    <TableColumn fx:id="colDireccion" text="Dirección"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- TAB 2: INSERCIÓN -->
    <Tab text="Inserción">
        <GridPane hgap="10" vgap="10">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label text="Nombre de usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNomUsuario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtPasswordNuevo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Nombres:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombres" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Apellidos:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtApellidos" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Dirección:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtDireccion" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Teléfono:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTelefono" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Button text="Registrar usuario" onAction="#onInsertar"
                    GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>
    </Tab>

    <!-- TAB 3: ELIMINACIÓN -->
    <Tab text="Eliminación">
        <VBox spacing="10">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="ID del usuario a eliminar:"/>
            <TextField fx:id="txtIdEliminar" promptText="Ej. 3" maxWidth="200"/>
            <Button text="Eliminar" onAction="#onEliminar"/>
        </VBox>
    </Tab>
</TabPane>
